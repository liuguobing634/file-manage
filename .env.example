# ===== 登录账号 =====
# 启动时指定账号密码（必填）；也可以只提供密码哈希（更安全），见 ADMIN_PASSWORD_HASH
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 可选：scrypt 密码哈希，优先级高于 ADMIN_PASSWORD
# 生成命令：npm run hash-password -- '你的密码'
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt-base64>$<hash-base64>

# ===== JWT =====
# 不设置时会随机生成（进程重启后已签发 token 全部失效，生产环境请务必设置）
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_TTL_SECONDS=7200

# ===== 允许管理的文件夹（多选，逗号分隔，必须为绝对路径）=====
# 所有文件操作都被限制在这些目录内（含软链接逃逸检测）
ALLOWED_ROOTS=/data,/srv/logs

# ===== 服务监听 =====
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false
LOG_LEVEL=info

# ===== 数据与限制 =====
# TOTP 密钥、审计日志存放目录（Docker 部署请挂载为卷）
DATA_DIR=./data/
MAX_LIST_FILES=5000
MAX_LIST_DEPTH=16
MAX_DELETE_PATHS=1000
MAX_ZIP_FILES=20000
LOGIN_RATE_WINDOW_SECONDS=600
LOGIN_RATE_MAX_ATTEMPTS=10
TOTP_RATE_WINDOW_SECONDS=60
TOTP_RATE_MAX_ATTEMPTS=10

# ===== TOTP 参数 =====
# 验证器 App 里显示的名称
TOTP_ISSUER=file-manage
# 验证码位数 / 周期（秒）/ 算法（SHA1 / SHA256 / SHA512）
TOTP_DIGITS=6
TOTP_PERIOD=30
TOTP_ALGORITHM=SHA256
# 允许的时间漂移（±N 个周期），手机时间不准时可以调大
TOTP_WINDOW=1
# 同一验证码只能使用一次（防重放）。关闭后同一 30 秒窗口内可以连续多次删除
TOTP_PREVENT_REPLAY=true

# ===== 其它 =====
# 是否提供内置 Web 控制台（public/index.html）
SERVE_STATIC=true

# ===== Docker 构建参数（仅 docker compose 使用，服务本身不读取）=====
# 服务器无法访问 docker.io 时，改成内网 registry 地址，或改成「已 docker load 进来的本地镜像名」
# BASE_IMAGE=harbor.intranet/library/node:22-alpine
BASE_IMAGE=node:22-alpine
# npm 源（内网可用 Nexus / Verdaccio / npmmirror）
NPM_REGISTRY=https://registry.npmjs.org

